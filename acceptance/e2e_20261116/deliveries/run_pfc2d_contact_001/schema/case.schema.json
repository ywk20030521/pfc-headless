{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/pfc-headless/case.schema.json",
  "title": "PFC Headless Case",
  "type": "object",
  "required": ["schema_version", "case_id", "case_name", "engine_dimension", "config_path", "model_path", "script_path", "parameters", "data_collection_config", "created_utc"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "case_id": {"type": "integer", "minimum": 0},
    "case_name": {"type": "string", "minLength": 1},
    "engine_dimension": {"enum": [2, 3]},
    "config_path": {"type": "string", "minLength": 1},
    "model_path": {"type": ["string", "null"]},
    "script_path": {"type": ["string", "null"]},
    "parameters": {"type": "object"},
    "data_collection_config": {
      "type": "object",
      "required": ["mode", "interval", "capture_contacts"],
      "properties": {
        "mode": {"enum": ["cycle", "time", "event"]},
        "interval": {"type": "number", "minimum": 0},
        "capture_contacts": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "created_utc": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
