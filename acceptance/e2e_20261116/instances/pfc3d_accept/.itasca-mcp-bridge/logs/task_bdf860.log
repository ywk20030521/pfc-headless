pfc3d>fish define _pfc_live_capture_frame
Fish>if _pfc_live_capture_enabled = false then
Fish>exit
Fish>endif
Fish>_pfc_live_capture_frame_id = _pfc_live_capture_frame_id + 1
Fish>local fid = _pfc_live_capture_frame_id
Fish>local cyc = mech.cycle()
Fish>local mt = mech.time.total()
Fish>_pfc_live_capture_last_cycle = cyc
Fish>_pfc_live_capture_last_time = mt
Fish>local bf = file.open(_pfc_live_capture_frame_path,'append','text')
Fish>local brows = list()
Fish>loop foreach local b ball.list
Fish>local bv = ball.vel(b)
Fish>local bs = ball.spin(b)
Fish>brows = list.append(brows,string.build('%1,%2,%3,%4,%5,%6,%7,%8,%9', ...
Fish>fid,ball.id(b),comp.x(ball.pos(b)),comp.y(ball.pos(b)), ...
Fish>_pfc_live_capture_z(ball.pos(b)),ball.radius(b), ...
Fish>comp.x(bv),comp.y(bv),_pfc_live_capture_vel_z(bv)) + ',' + ...
Fish>string.build('%1,%2,%3',_pfc_live_capture_spin_x(bs), ...
Fish>_pfc_live_capture_spin_y(bs),_pfc_live_capture_spin_z(bs)))
Fish>endloop
Fish>file.write(bf,brows)
Fish>file.close(bf)
Fish>local wf = file.open(_pfc_live_capture_walls_path,'append','text')
Fish>local wrows = list()
Fish>loop foreach local v wall.vertex.list()
Fish>local wp = wall.vertex.pos(v)
Fish>wrows = list.append(wrows,string.build('%1,%2,%3,%4,%5', ...
Fish>fid,wall.vertex.id(v),comp.x(wp),comp.y(wp),_pfc_live_capture_z(wp)))
Fish>endloop
Fish>file.write(wf,wrows)
Fish>file.close(wf)
Fish>if _pfc_live_capture_contacts = true then
Fish>local cf = file.open(_pfc_live_capture_contacts_path,'append','text')
Fish>local crows = list()
Fish>loop foreach local c contact.list
Fish>local cp = contact.pos(c)
Fish>local cforce = contact.force.global(c)
Fish>local e1 = contact.end1(c)
Fish>local e2 = contact.end2(c)
Fish>crows = list.append(crows,string.build('%1,%2,%3,%4,%5,%6,%7,%8,%9', ...
Fish>fid,contact.id(c),type.pointer(e1),type.pointer.id(e1), ...
Fish>type.pointer(e2),type.pointer.id(e2),comp.x(cp),comp.y(cp), ...
Fish>_pfc_live_capture_z(cp)) + ',' + ...
Fish>string.build('%1,%2,%3,%4',comp.x(cforce),comp.y(cforce), ...
Fish>_pfc_live_capture_vel_z(cforce),contact.model(c)))
Fish>endloop
Fish>file.write(cf,crows)
Fish>file.close(cf)
Fish>endif
Fish>local ix = file.open(_pfc_live_capture_index_path,'append','text')
Fish>local irow = list()
Fish>if _pfc_live_capture_wall_top > 0 then
Fish>local w1 = wall.find(_pfc_live_capture_wall_top)
Fish>local w2 = wall.find(_pfc_live_capture_wall_bottom)
Fish>local p1 = wall.pos(w1)
Fish>local p2 = wall.pos(w2)
Fish>local f1 = wall.force.contact(w1)
Fish>local f2 = wall.force.contact(w2)
Fish>irow = list.append(irow,string.build('%1,%2,%3,%4,%5,%6,%7,%8,%9', ...
Fish>fid,cyc,mt,ball.num(),comp.x(p1),comp.y(p1),_pfc_live_capture_z(p1), ...
Fish>comp.x(p2),comp.y(p2)) + ',' + string.build('%1,%2,%3,%4', ...
Fish>_pfc_live_capture_z(p2),math.mag(f1),math.mag(f2),_pfc_live_capture_calls) + ',' + ...
Fish>string.build('%1,%2',_pfc_live_capture_mode,_pfc_live_capture_value))
Fish>else
Fish>irow = list.append(irow,string.build('%1,%2,%3,%4,,,,,,,,,%5', ...
Fish>fid,cyc,mt,ball.num(),_pfc_live_capture_calls) + ',' + ...
Fish>string.build('%1,%2',_pfc_live_capture_mode,_pfc_live_capture_value))
Fish>endif
Fish>file.write(ix,irow)
Fish>file.close(ix)
Fish>end
pfc3d>fish define _pfc_live_capture_cycle
Fish>_pfc_live_capture_calls = _pfc_live_capture_calls + 1
