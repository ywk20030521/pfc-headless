Fish>if (mech.cycle() - _pfc_live_capture_last_cycle) >= _pfc_live_capture_stride then
Fish>_pfc_live_capture_frame
Fish>endif
Fish>else
Fish>if _pfc_live_capture_mode = 'time' then
Fish>if (mech.time.total() - _pfc_live_capture_last_time) >= _pfc_live_capture_value then
Fish>_pfc_live_capture_frame
Fish>endif
Fish>endif
Fish>endif
Fish>endif
Fish>end
