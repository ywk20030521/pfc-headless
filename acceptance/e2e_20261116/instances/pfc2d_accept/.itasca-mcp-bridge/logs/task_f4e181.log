Fish>global _pfc_live_capture_value = 1.0
Fish>global _pfc_live_capture_last_cycle = -1
Fish>global _pfc_live_capture_last_time = -1.0
Fish>global _pfc_live_capture_calls = 0
Fish>global _pfc_live_capture_events = 0
Fish>global _pfc_live_capture_contacts = false
